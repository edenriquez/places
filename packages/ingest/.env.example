# Postgres local de Supabase (supabase start). En producción: connection string del proyecto.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54362/postgres

# Storage. Local: URL y service_role de `supabase status`. En producción: las del proyecto.
SUPABASE_URL=http://127.0.0.1:54361
SUPABASE_SERVICE_KEY=

# Ollama local
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3.5:9b
OCR_MODEL=glm-ocr
OCR_ENGINE=apple          # apple | glm | tesseract | paddle | none

