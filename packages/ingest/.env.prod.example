# Perfil de PRODUCCIÓN del worker (`PLACES_ENV_FILE=.env.prod places-ingest worker`).
# Lo genera `ops/worker.sh setup`; solo hace falta pegar la contraseña de la base.
# El .env normal sigue apuntando a Supabase local para capturar eventos en localhost.

# Session pooler (IPv4, puerto 5432). La contraseña es la de Project Settings → Database
# (la misma que el secret SUPABASE_DB_PASSWORD / TF_VAR_supabase_db_password).
DATABASE_URL=postgresql://postgres.swsdnphwstuvrjhrpmlw:PEGA_AQUI_LA_CONTRASENA@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Storage (bucket flyers) con la llave service_role del proyecto.
SUPABASE_URL=https://swsdnphwstuvrjhrpmlw.supabase.co
SUPABASE_SERVICE_KEY=

# Ollama / OCR igual que en local
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3.5:9b
OCR_MODEL=glm-ocr
OCR_ENGINE=apple

# Worker
# WORKER_NAME=mac-mini            # default: hostname
WORKER_POLL_S=10                  # cada cuánto busca tareas
WORKER_HEARTBEAT_S=15             # cada cuánto avisa que sigue viva (la web la da por caída a los 45 s)
AUTO_PROCESS=true                 # encolar "process" solo cuando hay flyers en cola
AUTO_SCRAPE=true                  # encolar "scrape" cuando alguna fuente toca por intervalo

PLAYWRIGHT_HEADLESS=true
# FACEBOOK_STORAGE_STATE=/Users/tu-usuario/.config/entrelugares/fb_state.json
