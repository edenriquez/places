<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Worker remoto: la Mac apunta a producción (.env.prod), manda heartbeat y toma tareas de la tabla jobs.
       Se instala con ops/worker.sh install (sustituye __REPO__ y __UV__ por las rutas reales). -->
  <key>Label</key><string>mx.entrelugares.worker</string>
  <key>ProgramArguments</key>
  <array>
    <!-- caffeinate -s: la Mac no se duerme mientras esté conectada a la corriente; con batería sí puede dormir -->
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__REPO__/packages/ingest</string>
    <string>places-ingest</string>
    <string>worker</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/packages/ingest</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>180</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__REPO__/packages/ingest/data/logs/worker.log</string>
  <key>StandardErrorPath</key><string>__REPO__/packages/ingest/data/logs/worker.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>PLACES_ENV_FILE</key><string>.env.prod</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
</dict>
</plist>
